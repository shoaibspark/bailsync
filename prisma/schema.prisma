// Bailsync — Prisma schema
// Event-sourced cricket scoring: BallEvent rows are immutable; derived totals are
// recomputed by the pure reducer over the event stream.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SCORER
  VIEWER
}

enum TournamentFormat {
  LEAGUE
  KNOCKOUT
  GROUP_KNOCKOUT
}

enum MatchStatus {
  SCHEDULED
  LIVE
  INNINGS_BREAK
  COMPLETED
  ABANDONED
}

enum TossDecision {
  BAT
  BOWL
}

enum ResultType {
  WIN_RUNS
  WIN_WICKETS
  TIE
  NO_RESULT
  ABANDONED
}

enum PlayerRole {
  BATTER
  BOWLER
  ALL_ROUNDER
  WICKET_KEEPER
}

enum ExtraType {
  NONE
  WIDE
  NO_BALL
  BYE
  LEG_BYE
  PENALTY
}

enum WicketType {
  BOWLED
  CAUGHT
  LBW
  RUN_OUT
  STUMPED
  HIT_WICKET
  RETIRED_HURT
  RETIRED_OUT
  OBSTRUCTING_FIELD
  TIMED_OUT
}

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String?
  email        String   @unique
  passwordHash String
  role         Role     @default(VIEWER)
  clubId       String?  @db.Uuid
  club         Club?    @relation("ClubMembers", fields: [clubId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  activeScoredMatches Match[] @relation("ActiveScorer")

  @@index([email])
  @@index([clubId])
}

model Club {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique
  shortName   String?
  city        String?
  logoUrl     String?
  createdAt   DateTime @default(now())

  players             Player[]
  members             User[]      @relation("ClubMembers")
  homeMatches         Match[]     @relation("HomeClub")
  awayMatches         Match[]     @relation("AwayClub")
  tossWonMatches      Match[]     @relation("TossWinner")
  wonMatches          Match[]     @relation("WinnerClub")
  inningsBatting      Innings[]   @relation("BattingClub")
  inningsBowling      Innings[]   @relation("BowlingClub")
  squads              MatchSquad[]

  @@index([name])
}

model Player {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clubId        String      @db.Uuid
  club          Club        @relation(fields: [clubId], references: [id], onDelete: Cascade)
  name          String
  jerseyNumber  Int?
  battingStyle  String?
  bowlingStyle  String?
  role          PlayerRole  @default(BATTER)
  createdAt     DateTime    @default(now())

  squads            MatchSquad[]
  ballEventsAsStriker   BallEvent[] @relation("Striker")
  ballEventsAsNonStriker BallEvent[] @relation("NonStriker")
  ballEventsAsBowler BallEvent[] @relation("Bowler")
  ballEventsAsDismissed BallEvent[] @relation("DismissedPlayer")
  ballEventsAsFielder BallEvent[] @relation("Fielder")

  @@index([clubId])
  @@index([name])
  @@unique([name, clubId])
}

model Tournament {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String             @unique
  format           TournamentFormat   @default(LEAGUE)
  oversPerInnings  Int                @default(20)
  maxOversPerBowler Int               @default(4)
  ballsPerOver     Int                @default(6)
  wideRuns         Int                @default(1)
  noBallRuns       Int                @default(1)
  lastManStands    Boolean            @default(false)
  pointsWin        Int                @default(2)
  pointsTie        Int                @default(1)
  pointsNoResult   Int                @default(1)
  createdAt        DateTime           @default(now())

  matches Match[]

  @@index([name])
}

model Match {
  id                 String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tournamentId       String?        @db.Uuid
  tournament         Tournament?    @relation(fields: [tournamentId], references: [id], onDelete: SetNull)
  homeClubId         String         @db.Uuid
  homeClub           Club           @relation("HomeClub", fields: [homeClubId], references: [id])
  awayClubId         String         @db.Uuid
  awayClub           Club           @relation("AwayClub", fields: [awayClubId], references: [id])
  venue              String?
  scheduledAt        DateTime?
  status             MatchStatus    @default(SCHEDULED)
  tossWinnerClubId   String?        @db.Uuid
  tossWinner         Club?          @relation("TossWinner", fields: [tossWinnerClubId], references: [id], onDelete: SetNull)
  tossDecision       TossDecision?
  oversPerInnings    Int            @default(20)
  maxOversPerBowler  Int            @default(4)
  activeScorerId     String?        @db.Uuid
  activeScorer       User?          @relation("ActiveScorer", fields: [activeScorerId], references: [id], onDelete: SetNull)
  scorerHandoffCode  String?
  handoffExpiresAt   DateTime?
  resultSummary      String?
  resultType         ResultType?
  winnerClubId       String?        @db.Uuid
  winnerClub         Club?          @relation("WinnerClub", fields: [winnerClubId], references: [id], onDelete: SetNull)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  innings            Innings[]
  squads             MatchSquad[]

  @@index([tournamentId])
  @@index([status])
  @@index([homeClubId])
  @@index([awayClubId])
  @@index([activeScorerId])
}

model MatchSquad {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  matchId        String   @db.Uuid
  match          Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  clubId         String   @db.Uuid
  club           Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  playerId       String   @db.Uuid
  player         Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  isPlayingXI    Boolean  @default(false)
  isCaptain      Boolean  @default(false)
  isWicketKeeper Boolean  @default(false)

  @@unique([matchId, playerId])
  @@index([matchId])
  @@index([clubId])
}

model Innings {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  matchId        String   @db.Uuid
  match          Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  inningsNumber  Int
  battingClubId  String   @db.Uuid
  battingClub    Club     @relation("BattingClub", fields: [battingClubId], references: [id])
  bowlingClubId  String   @db.Uuid
  bowlingClub    Club     @relation("BowlingClub", fields: [bowlingClubId], references: [id])
  targetRuns     Int?
  isCompleted    Boolean  @default(false)
  createdAt      DateTime @default(now())

  ballEvents     BallEvent[]

  @@unique([matchId, inningsNumber])
  @@index([matchId])
  @@index([battingClubId])
  @@index([bowlingClubId])
}

model BallEvent {
  id                String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  inningsId         String      @db.Uuid
  innings           Innings     @relation(fields: [inningsId], references: [id], onDelete: Cascade)
  sequenceNumber    Int
  overNumber        Int
  ballInOver        Int
  strikerId         String      @db.Uuid
  striker           Player      @relation("Striker", fields: [strikerId], references: [id])
  nonStrikerId      String      @db.Uuid
  nonStriker        Player      @relation("NonStriker", fields: [nonStrikerId], references: [id])
  bowlerId          String      @db.Uuid
  bowler            Player      @relation("Bowler", fields: [bowlerId], references: [id])
  runsScored        Int         @default(0)
  extraType         ExtraType   @default(NONE)
  extraRuns         Int         @default(0)
  isWicket          Boolean     @default(false)
  wicketType        WicketType?
  dismissedPlayerId String?     @db.Uuid
  dismissedPlayer   Player?     @relation("DismissedPlayer", fields: [dismissedPlayerId], references: [id], onDelete: SetNull)
  fielderId         String?     @db.Uuid
  fielder           Player?     @relation("Fielder", fields: [fielderId], references: [id], onDelete: SetNull)
  wagonWheelZone    Int?
  commentaryText    String?
  clientEventId     String?     @unique
  incomingBatterId  String?     @db.Uuid
  deletedAt         DateTime?
  updatedAt         DateTime   @updatedAt
  createdAt         DateTime    @default(now())

  @@unique([inningsId, sequenceNumber])
  @@index([inningsId])
  @@index([bowlerId])
  @@index([strikerId])
  @@index([nonStrikerId])
  @@index([clientEventId])
  @@index([deletedAt])
}
